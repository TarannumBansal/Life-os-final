  "recipes": [
    {
      "id": "paneer-bhurji",
      "name": "Paneer Bhurji",
      "time_min": 25,
      "ingredients": [
        "200g paneer, crumbled",
        "1 onion",
        "1 tomato",
        "1 green chilli",
        "Turmeric, cumin, salt"
      ],
      "steps": [
        "Heat skillet with 1 tsp oil.",
        "Sauté onion 3 min.",
        "Add tomato + spices, cook 4 min.",
        "Add crumbled paneer, toss 3 min.",
        "Serve with 2 chapati."
      ]
    },
    {
      "id": "besan-chilla",
      "name": "Besan Chilla",
      "time_min": 20,
      "ingredients": [
        "1 cup besan",
        "1/2 onion chopped",
        "Coriander",
        "Green chilli",
        "Salt, turmeric"
      ],
      "steps": [
        "Whisk besan with water to pancake batter.",
        "Add veg and spices.",
        "Skillet on medium — pour batter thin.",
        "Flip when edges dry, 2 min per side.",
        "Serve with mint chutney."
      ]
    },
    {
      "id": "moong-khichdi",
      "name": "Moong Dal Khichdi",
      "time_min": 25,
      "ingredients": [
        "1/2 cup rice",
        "1/2 cup moong dal",
        "Turmeric, cumin, ginger",
        "Ghee 1 tsp"
      ],
      "steps": [
        "Rinse rice + dal.",
        "Skillet — temper cumin + ginger in ghee.",
        "Add rice, dal, 3 cups water, salt.",
        "Cover, low flame 20 min.",
        "Serve hot with curd."
      ]
    }
  ],
